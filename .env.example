PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# Gmail account used to SEND the notification email (needs an App Password, not your normal password)
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your16characterapppassword

# Where you want to RECEIVE contact-form notifications (can be the same as EMAIL_USER)
NOTIFY_EMAIL=youraddress@gmail.com

# Groq API key for the "Ask about Pascal" chat widget — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
